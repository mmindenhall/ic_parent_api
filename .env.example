# Infinite Campus (Jeffco SSO login)
IC_BASE_URL=https://jeffco.infinitecampus.org
IC_USERNAME=
IC_PASSWORD=
IC_DISTRICT=Jeffco_IC

# Students: first names as Infinite Campus lists them. The first is the default; `run --student NAME` picks another.
TRACKER_STUDENTS=Alex,Sam

# Email (testing: to yourself only; live: TO=the student, CC=both parents)
TRACKER_EMAIL_TO=parent1@example.com
TRACKER_EMAIL_CC=
TRACKER_ALERT_TO=

# Optional overrides (defaults shown)
# TRACKER_TIMEZONE=America/Denver
# TRACKER_EXCLUDE_COURSES=Seminar
# TRACKER_TOKEN_TTL_DAYS=7        # 'none' once the Google app is in Production
# TRACKER_SHEET_NAME=Assignments Tracker
# TRACKER_DRIVE_FOLDER=Kids/{student}   # '{student}' = the selected first name
# TRACKER_CACHE_DIR=~/.cache/ic-tracker
# TRACKER_OP_CLIENT_ID_REF=op://Private/Google Personal Automation Hub OAuth/username
# TRACKER_OP_CLIENT_SECRET_REF=op://Private/Google Personal Automation Hub OAuth/credential
